{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "extension-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "extension"
      ],
      "port": 8765
    },
    {
      "name": "site",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd site && npx wrangler dev --port 8766"
      ],
      "port": 8766
    }
  ]
}